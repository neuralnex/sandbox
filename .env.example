APP_ENV=development
APP_NAME=Sandbox API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://sandbox:sandbox@localhost:5432/sandbox
REDIS_URL=redis://localhost:6379/0
SIMULATION_MAX_RUNTIME_SECONDS=600
CORS_ORIGINS=["http://localhost:3000"]

# Firebase Admin verifies client ID tokens; use Application Default Credentials
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
FIREBASE_PROJECT_ID=fire-detection-425522
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Optional service-account JSON for local/container development. Keep it secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# OpenRouter is optional until an AI-backed workflow is enabled.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Sandbox
LLM_TIMEOUT_SECONDS=60
