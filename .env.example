APP_ENV=development
APP_NAME=Sandbox API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://sandbox:sandbox@localhost:5432/sandbox
# For a hosted deployment, use the Supabase Postgres connection string. Prefer
# the session pooler if your host cannot make IPv6 direct connections.
REDIS_URL=redis://localhost:6379/0
SIMULATION_MAX_RUNTIME_SECONDS=600
CORS_ORIGINS=["http://localhost:3000"]
# Emails permitted to view and count waitlist signups. Use the account email used in Sandbox.
WAITLIST_ADMIN_EMAILS=["you@example.com"]

# Firebase Admin verifies client ID tokens; use Application Default Credentials
# or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
FIREBASE_PROJECT_ID=fire-detection-425522
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Optional service-account JSON for local/container development. Keep it secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# OpenRouter is optional until an AI-backed workflow is enabled.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Sandbox
LLM_TIMEOUT_SECONDS=60

# Live research uses Firecrawl search/scrape; keep this server-side only.
FIRECRAWL_API_KEY=

# Optional x402 endpoint for AI agents. Leave SOLANA_PAY_TO blank to disable.
# Devnet CAIP-2 network; change only when configuring a production facilitator.
SOLANA_PAY_TO=
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_RESEARCH_PRICE="$0.05"
